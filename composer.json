{
    "name": "cleatsquad/php-grpc-frame-codec",
    "description": "PHP codec for the standard 5-byte gRPC message frame used by franken-grpc-style relays — runtime-agnostic, no dependency on FrankenPHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "grpc",
        "franken-grpc",
        "protobuf",
        "wire-format"
    ],
    "homepage": "https://github.com/CleatSquad/php-grpc-frame-codec",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/CleatSquad/php-grpc-frame-codec/issues",
        "source": "https://github.com/CleatSquad/php-grpc-frame-codec"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\GrpcFrameCodec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\GrpcFrameCodec\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
