{
    "name": "cleatsquad/franken-grpc-codec-php",
    "description": "PHP framing codec for franken-grpc backends: the 5-byte gRPC message frame your backend must send back to the relay.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/CleatSquad/franken-grpc-codec-php",
    "support": {
        "issues": "https://github.com/CleatSquad/franken-grpc-codec-php/issues",
        "source": "https://github.com/CleatSquad/franken-grpc-codec-php"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\FrankenGrpcCodec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\FrankenGrpcCodec\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
